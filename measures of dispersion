        "import pandas as pd\n",
        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "import seaborn as sns\n",
        "\n",
        "\n",
        "df = sns.load_dataset('titanic')\n",
        "\n",
        "print(\"First five rows:\")\n",
        "print(df.head())\n",
        "\n",
        "data = df[['age', 'fare']]\n",
        "\n",
        "data = data.dropna()\n",
        "\n",
        "\n",
        "for column in data.columns:\n",
        "    print(\"\\nMeasures of Dispersion for\", column)\n",
        "\n",
        "    data_range = data[column].max() - data[column].min()\n",
        "    print(\"Range:\", data_range)\n",
        "\n",
        "    variance = data[column].var()\n",
        "    print(\"Variance:\", variance)\n",
        "\n",
        "    std_dev = data[column].std()\n",
        "    print(\"Standard Deviation:\", std_dev)\n",
        "\n",
        "    mad = (data[column] - data[column].mean()).abs().mean()\n",
        "    print(\"Mean Absolute Deviation:\", mad)\n",
        "\n",
        "    Q1 = data[column].quantile(0.25)\n",
        "    Q3 = data[column].quantile(0.75)\n",
        "    IQR = Q3 - Q1\n",
        "    print(\"Q1:\", Q1)\n",
        "    print(\"Q3:\", Q3)\n",
        "    print(\"Interquartile Range:\", IQR)\n",
        "\n",
        "    cv = (std_dev / data[column].mean()) * 100\n",
        "    print(\"Coefficient of Variation:\", cv, \"%\")\n",
        "\n",
        "plt.figure(figsize=(12, 5))\n",
        "\n",
        "plt.subplot(1, 2, 1)\n",
        "sns.histplot(df['age'].dropna(), bins=20, kde=True)\n",
        "plt.title(\"Distribution of Passenger Age\")\n",
        "plt.xlabel(\"Age\")\n",
        "plt.ylabel(\"Frequency\")\n",
        "\n",
        "plt.subplot(1, 2, 2)\n",
        "sns.histplot(df['fare'].dropna(), bins=30, kde=True)\n",
        "plt.title(\"Distribution of Ticket Fare\")\n",
        "plt.xlabel(\"Fare\")\n",
        "plt.ylabel(\"Frequency\")\n",
        "\n",
        "plt.tight_layout()\n",
        "plt.show()\n",
        "\n",
        "# Step 8: Plot box plots\n",
        "plt.figure(figsize=(12, 5))\n",
        "\n",
        "plt.subplot(1, 2, 1)\n",
        "sns.boxplot(x=df['age'])\n",
        "plt.title(\"Box Plot of Passenger Age\")\n",
        "plt.xlabel(\"Age\")\n",
        "\n",
        "plt.subplot(1, 2, 2)\n",
        "sns.boxplot(x=df['fare'])\n",
        "plt.title(\"Box Plot of Ticket Fare\")\n",
        "plt.xlabel(\"Fare\")\n",
        "\n",
        "plt.tight_layout()\n",
        "plt.show()\n",
        "\n",
        "# Step 9: Plot density curves\n",
        "plt.figure(figsize=(12, 5))\n",
        "\n",
        "sns.kdeplot(df['age'].dropna(), fill=True, label=\"Age\")\n",
        "plt.title(\"Density Distribution of Passenger Age\")\n",
        "plt.xlabel(\"Age\")\n",
        "plt.ylabel(\"Density\")\n",
        "plt.legend()\n",
        "plt.show()\n",
        "\n",
        "plt.figure(figsize=(12, 5))\n",
        "\n",
        "sns.kdeplot(df['fare'].dropna(), fill=True, label=\"Fare\")\n",
        "plt.title(\"Density Distribution of Ticket Fare\")\n",
        "plt.xlabel(\"Fare\")\n",
        "plt.ylabel(\"Density\")\n",
        "plt.legend()\n",
        "plt.show()"
